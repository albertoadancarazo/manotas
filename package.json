{
  "name": "manotas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply manotas-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply manotas-db --remote",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test.mjs",
    "build": "node scripts/build.mjs",
    "admin:sql": "node scripts/admin-sql.mjs",
    "test:worker": "node scripts/smoke-worker.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261019.1",
    "@types/node": "^26.6.5",
    "esbuild-wasm": "^0.28.2",
    "typescript": "^5.9.0",
    "wrangler": "^4.0.0",
    "miniflare": "5.20261019.0-beta"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "@types/qrcode": "^1.5.6",
    "jose": "^6.2.12",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4"
  },
  "overrides": {
    "undici": "7.30.1"
  },
  "engines": {
    "node": ">=24"
  }
